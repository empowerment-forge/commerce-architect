{
  "business_profile": {
    "business_type": "retail",
    "size": "small",
    "growth_expectation": "moderate"
  },
  "commerce_requirements": {
    "products": "physical",
    "subscriptions": true,
    "one_time_payments": true,
    "tax_handling": "simple",
    "inventory": "basic"
  },
  "technical_constraints": {
    "backend_language": "python",
    "frontend": ["react"],
    "payment_provider": "stripe",
    "hosting_preference": "managed_cloud"
  },
  "nonfunctional_requirements": {
    "security_level": "high",
    "compliance": ["pci_scope_minimized"],
    "uptime_target": "99.5",
    "budget_sensitivity": "high"
  },
  "phase_1_constraints": {
	  "hosting_budget": "free_or_under_10_usd",
	  "disallowed_clouds": ["aws", "gcp", "azure"],
	  "admin_required": true,
	  "business_capabilities": [
		"sell_services",
		"sell_products",
		"inventory_management",
		"scheduling",
		"reservations"
	  ]
	},
  "phase": "phase_1" 
}
