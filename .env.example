# Safe local-development examples only. Do not reuse these values in production.
COMMERCE_ENV=development
DJANGO_SECRET_KEY=django-insecure-development-only-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_FORWARDED_PROTO=false
AUTH_REQUIRE_VERIFIED_EMAIL=true
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RECOVERY_TTL_SECONDS=1800
AUTH_PASSWORD_RECOVERY_RESEND_COOLDOWN_SECONDS=60
AUTH_FRONTEND_BASE_URL=http://localhost:5173
EMAIL_BACKEND=accounts.mail.ReadableConsoleEmailBackend
DEFAULT_FROM_EMAIL=Commerce Architect <noreply@localhost>

# Development-only destructive catalog purge; keep disabled by default.
CATALOG_ALLOW_DESTRUCTIVE_RESET=false

# Optional real-email UAT. Keep EMAIL_BACKEND above for console mail, or select
# SMTP and put the actual password only in your untracked .env file. Resend is
# the currently tested SMTP example; these standard variables work with any SMTP provider.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=<secret>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Commerce Architect <accounts@empowerment-forge.com>

POSTGRES_DB=commerce_db
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commercepass
DATABASE_HOST=db
DATABASE_NAME=commerce_db
DATABASE_USER=commerce
DATABASE_PASSWORD=commercepass
DATABASE_PORT=5432

VITE_API_PROXY_TARGET=http://web:8000
