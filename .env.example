# Safe local-development examples only. Do not reuse these values in production.
COMMERCE_ENV=development
DJANGO_SECRET_KEY=django-insecure-development-only-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_FORWARDED_PROTO=false
AUTH_REQUIRE_VERIFIED_EMAIL=true
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_FRONTEND_BASE_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Commerce Architect <noreply@localhost>

POSTGRES_DB=commerce_db
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commercepass
DATABASE_HOST=db
DATABASE_NAME=commerce_db
DATABASE_USER=commerce
DATABASE_PASSWORD=commercepass
DATABASE_PORT=5432

VITE_API_PROXY_TARGET=http://web:8000
